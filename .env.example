# Copy to .env and fill in your values.

# Required
OPENAI_API_KEY=sk-your-key-here

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_csv

# Models
EMBEDDING_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-4o-mini

# API
PORT=3000

# Retrieval tuning
TOP_K=5                 # documents passed to the LLM
RANK_WINDOW_SIZE=50     # candidates pulled from each retriever before fusion
RRF_RANK_CONSTANT=60    # RRF k constant (higher = flatter weighting)
KNN_CANDIDATES=100      # HNSW num_candidates for the kNN query

# Ingestion chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Logging
LOG_LEVEL=info
